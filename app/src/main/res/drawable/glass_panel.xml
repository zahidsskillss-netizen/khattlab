<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
            <gradient android:angle="270" android:startColor="#FF1B1B26" android:endColor="#FF101017" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
            <solid android:color="#2BFFFFFF" />
        </shape>
    </item>
</layer-list>
