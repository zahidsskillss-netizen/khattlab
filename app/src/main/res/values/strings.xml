    <string name="ab_app_text">NawakhtGar is an app for writing text in Pashto, Dari, Arabic and English on photos and making beautiful designs — everything a designer wants on a phone.</string>
    <string name="ab_f1">Free perspective: drag each corner on its own</string>
    <string name="ab_f2">Round each corner of a shape separately</string>
    <string name="ab_f3">Outline: follows the shape but with a gap</string>
    <string name="ab_f4">Image inside a shape, moved and zoomed by finger</string>
    <string name="ab_f5">Beautiful Bahij fonts and correct Pashto shaping</string>
    <string name="ab_f6">3D text, shadow, reflection and saved projects</string>
